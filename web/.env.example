# Copiază în web/.env.local și completează cu valorile tale.
# Pentru Supabase local, ia-le din output-ul `supabase start`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

# Hosturile aplicației PMS principale (CSV), folosite pentru a distinge
# "sunt pe pilow.app" de "sunt pe {slug}.pilow.app" (site public de proprietate).
# Necesar doar când se activează rutarea pe subdomeniu (Sprint 10 §5); dacă
# lipsește, comportamentul actual rămâne neschimbat (totul e servit pe path).
VITE_APP_HOSTS=pilow.app,www.pilow.app
